{
  "info": {
    "name": "Notes API",
    "description": "RESTful API for notes-taking app",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/",
          "host": ["{{baseUrl}}"],
          "path": [""]
        }
      },
      "response": []
    },
    {
      "name": "Get All Notes",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/notes?page=1&limit=10&sort=createdAt",
          "host": ["{{baseUrl}}"],
          "path": ["api", "notes"],
          "query": [
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "limit",
              "value": "10"
            },
            {
              "key": "sort",
              "value": "createdAt"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "Create New Note",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"My First Note\",\n  \"content\": \"This is the content of my first note. I can write anything here!\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/notes",
          "host": ["{{baseUrl}}"],
          "path": ["api", "notes"]
        }
      },
      "response": []
    },
    {
      "name": "Create Another Note",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Meeting Notes\",\n  \"content\": \"Today's meeting discussed the new project timeline and deliverables. Key points: 1) Project deadline is next Friday, 2) Need to coordinate with design team, 3) Client review scheduled for Wednesday.\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/notes",
          "host": ["{{baseUrl}}"],
          "path": ["api", "notes"]
        }
      },
      "response": []
    },
    {
      "name": "Get Note by ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/notes/:id",
          "host": ["{{baseUrl}}"],
          "path": ["api", "notes", ":id"],
          "variable": [
            {
              "key": "id",
              "value": "REPLACE_WITH_ACTUAL_NOTE_ID"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "Update Note",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Updated Meeting Notes\",\n  \"content\": \"Today's meeting discussed the new project timeline and deliverables. Key points: 1) Project deadline is next Friday, 2) Need to coordinate with design team, 3) Client review scheduled for Wednesday. UPDATE: Deadline extended to following Monday.\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/notes/:id",
          "host": ["{{baseUrl}}"],
          "path": ["api", "notes", ":id"],
          "variable": [
            {
              "key": "id",
              "value": "REPLACE_WITH_ACTUAL_NOTE_ID"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "Delete Note",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/notes/:id",
          "host": ["{{baseUrl}}"],
          "path": ["api", "notes", ":id"],
          "variable": [
            {
              "key": "id",
              "value": "REPLACE_WITH_ACTUAL_NOTE_ID"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "Delete All Notes",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/notes",
          "host": ["{{baseUrl}}"],
          "path": ["api", "notes"]
        }
      },
      "response": []
    },
    {
      "name": "Create Note - Validation Error (Missing Title)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"content\": \"This note is missing a title to test validation.\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/notes",
          "host": ["{{baseUrl}}"],
          "path": ["api", "notes"]
        }
      },
      "response": []
    },
    {
      "name": "Create Note - Validation Error (Title Too Long)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"This is an extremely long title that exceeds the maximum allowed length of 100 characters for the title field in our notes API validation system\",\n  \"content\": \"This note has a title that's too long to test validation.\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/notes",
          "host": ["{{baseUrl}}"],
          "path": ["api", "notes"]
        }
      },
      "response": []
    },
    {
      "name": "Get Non-existent Note",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/notes/507f1f77bcf86cd799439011",
          "host": ["{{baseUrl}}"],
          "path": ["api", "notes", "507f1f77bcf86cd799439011"]
        }
      },
      "response": []
    },
    {
      "name": "Update Non-existent Note",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Updated Title\",\n  \"content\": \"Updated content for a note that doesn't exist.\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/notes/507f1f77bcf86cd799439011",
          "host": ["{{baseUrl}}"],
          "path": ["api", "notes", "507f1f77bcf86cd799439011"]
        }
      },
      "response": []
    }
  ]
}
